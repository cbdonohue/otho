# Otho v0.1 configuration
# Copy to .env and adjust.

# Database — SQLite works for local demo; Postgres is the production target.
# Docker compose default:
# DATABASE_URL=postgresql+asyncpg://otho:otho@postgres:5432/otho
DATABASE_URL=sqlite+aiosqlite:///./otho.db

# Redis — optional. Leave empty to use the in-process cache/event fallback.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# CORS — comma-separated origins for the local Vite frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Sleeper (public, no auth). Override only for tests/mocks.
SLEEPER_BASE_URL=https://api.sleeper.app/v1

# Optional: auto-sync this Sleeper league on boot
# DEFAULT_LEAGUE_ID=your_sleeper_league_id
DEFAULT_LEAGUE_ID=

# Ask Otho — OpenAI-compatible tool calling. If unset, a deterministic
# plugin-orchestration fallback still answers from plugin results.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Scheduler
ENABLE_SCHEDULER=true
LOG_LEVEL=INFO
